# 西电校园助手（EchoGuide）环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=EchoGuide
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
# 前端 Vite 代理目标（前端目录内设置，或构建时注入）：
# 本地开发默认 http://localhost:8100；Docker Compose 统一入口 http://localhost:8088（Nginx）
# VITE_API_URL=/api
# VITE_PYTHON_API_URL=http://localhost:8100

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 兼容旧模块（记忆压缩、评测、工具管理器）的默认模型
ANTHROPIC_MODEL=deepseek-v4-flash

# Agent 自适应执行配置：默认复用上方 API Key / Base URL，也可分别覆盖
ECHOGUIDE_FAST_MODEL=deepseek-v4-flash
ECHOGUIDE_DEEP_MODEL=deepseek-v4-pro
# ECHOGUIDE_FAST_API_KEY=
# ECHOGUIDE_FAST_BASE_URL=https://api.deepseek.com/anthropic
# ECHOGUIDE_DEEP_API_KEY=
# ECHOGUIDE_DEEP_BASE_URL=https://api.deepseek.com/anthropic

# 仅本地真实模型 Benchmark 使用；生产环境保持 0
ECHOGUIDE_BENCHMARK_ENABLED=0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=echoguide123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 本地向量模型（Embedding/Rerank，ONNX 轻量推理，无 torch）─────────────────
# Embedding：bge-small-zh-v1.5 中文优化（512 维）；模型不可用时全链路自动
# 回退 ChromaDB 内置 MiniLM + LLM 重排（collection 名随向量空间切换，不混存）
ECHOGUIDE_EMBEDDING_MODEL=onnx-community/bge-small-zh-v1.5-ONNX
# Rerank：bge-reranker-base cross-encoder（毫秒级本地重排）
ECHOGUIDE_RERANK_MODEL=Xenova/bge-reranker-base
# 重排后端：local=本地模型（默认，不可用自动降级 LLM）；llm=LLM 打分；off=关闭
ECHOGUIDE_RERANK_BACKEND=local
# 模型缓存目录（Docker 镜像构建时已预下载，运行时优先读本地缓存）
# ECHOGUIDE_MODEL_CACHE_DIR=~/.cache/echoguide_models
# chromadb 路径无法区分 query/document 时是否两侧都加 bge-zh 指令前缀
# （默认 none；BAAI 不建议给 passage 加指令，一般无需修改）
# ECHOGUIDE_EMBED_PREFIX_MODE=none
# 意图识别阈值（默认值按真实 bge 分数分布标定，见 evaluation/calibrate_intent_thresholds.py）
# ECHOGUIDE_INTENT_PATTERN_THRESHOLD=0.90
# ECHOGUIDE_INTENT_EMBEDDING_THRESHOLD=0.80
# ECHOGUIDE_INTENT_EMBEDDING_MARGIN=0.10
# 模型下载镜像端点（国内部署可设 https://hf-mirror.com，构建/运行时均生效）
# HF_ENDPOINT=https://huggingface.co

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ECHOGUIDE_SKILLS_DIR=./skills
ECHOGUIDE_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
# 会话签名密钥：生产环境（APP_ENV=production）缺失或仍为默认开发密钥时服务将拒绝启动
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# 可选：首次启动时创建管理员账号（仅对新建数据库生效；未配置则不创建）
# ECHOGUIDE_ADMIN_PASSWORD=change_this_admin_password

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true

# ── 语义缓存（GPTCache 思路，相似问题直接复用答案）──────────────────────────
SEMANTIC_CACHE_ENABLED=1
SEMANTIC_CACHE_THRESHOLD=0.85

# ── 个人数据中心（课表/待办/DDL，SQLite）───────────────────────────────────
# 个人数据按 user_id 隔离持久化；Docker 部署时固定为 /app/data/echoguide.db
ECHOGUIDE_DB_PATH=./data/echoguide.db
# HTTPS 部署时设为 1，使登录 Cookie 仅通过 HTTPS 发送
ECHOGUIDE_COOKIE_SECURE=0
# 是否允许用户自行注册（1=允许，0=仅使用预置/后台创建账号）
ECHOGUIDE_ALLOW_REGISTRATION=1

# ── 教学周与作息（时间感知：第几节/第几周）──────────────────────────────────
# 秋季学期开学日（周一）与总周数 —— 2026-2027 学年：2026-09-07 开学，19 周
SEMESTER_START=2026-09-07
SEMESTER_WEEKS=19
# 夏季作息启用月份（下午 14:30 上课；其余月份 14:00）
SUMMER_SCHEDULE_MONTHS=5,6,7,8,9

# ── 结构化公开信息（校车时刻/楼宇/场馆/图书馆）─────────────────────────────
# 数据文件目录：shuttle_schedule.json / buildings.json / venues.json / library.json
ECHOGUIDE_PUBLIC_DATA_DIR=./data/public

# ── 天气查询（和风天气免费版为主源，Open-Meteo 免 Key 兜底）─────────────────
# 填入后在 https://dev.qweather.com 注册"免费订阅"获取的 API Key（每日约 1000 次调用，
# 额度用尽返回 402 并自动回退 Open-Meteo，北京时间每日 0 点重置）。
# 2025-04 起和风为每个账号分配专属 API Host（控制台 → 设置 → API Host，形如
# abc1234xyz.def.qweatherapi.com），新注册的 Key 必须同时配置 QWEATHER_API_HOST，
# 否则报 403 Invalid Host；老账号可留空（回退 devapi.qweather.com 公共域名）。
# 全部留空则直接使用 Open-Meteo（免 Key，但为境外服务，国内网络可能不通）。
# QWEATHER_API_KEY=
# QWEATHER_API_HOST=

# ── RAG 知识库投放目录（默认 data/knowledge_docs）───────────────────────────
# 把 pdf/docx/txt/md/json 放进目录，启动时自动入库（重复启动幂等，不会重复切片）
# ECHOGUIDE_KNOWLEDGE_DOCS_DIR=./data/knowledge_docs

# ── EchoGuard 安全中间件（默认启用：注入检测/限流/脱敏审计）─────────────────
# 保护 /chat、/personal/*、/mcp 等 POST 端点；自身异常时自动放行，不影响可用性
ECHOGUIDE_GUARD_ENABLED=1
# 可选：配置后受保护端点要求 Bearer Token 认证（无登录体系时按需开启）
# ECHOGUIDE_GUARD_TOKEN=change-me
# ECHOGUIDE_GUARD_MAX_MESSAGE_CHARS=2000
# ECHOGUIDE_GUARD_USER_RATE=30
# ECHOGUIDE_GUARD_IP_RATE=120

# ── Agent Runtime 执行预算（默认值可覆盖；工具轮次已升级为分级上限+无进展检测）─
# 协作目标 Agent 上限（原 targets[:3]）
# ECHOGUIDE_RUNTIME_MAX_AGENTS=3
# 协作任务 DAG 上限（原 TaskExecutor 上限 6）
# ECHOGUIDE_RUNTIME_MAX_TASKS=6
# Fast 路径工具轮次上限（保险丝，防死循环；模型不请求工具即停，原统一 2）
# ECHOGUIDE_RUNTIME_MAX_TOOL_ROUNDS_FAST=3
# Deep 路径工具轮次上限（复杂任务留给 Deep）
# ECHOGUIDE_RUNTIME_MAX_TOOL_ROUNDS_DEEP=5
# 无进展检测：连续 N 轮工具调用与上一轮完全重复（同名同参，含失败重试）→ 强制收尾
# ECHOGUIDE_RUNTIME_STAGNANT_ROUND_LIMIT=2
# 单请求真实模型调用次数上限（经 ModelGateway 统一计数，覆盖意图识别/工具循环/
# 合成/出口校验/记忆提炼等全部 LLM 调用；0 = 仅计数不强限）
# ECHOGUIDE_RUNTIME_MAX_MODEL_CALLS=0
# 单请求工具调用总次数上限（0 = 仅计数不强限）
# ECHOGUIDE_RUNTIME_MAX_TOOL_CALLS=0
# 失败降级次数上限（Fast→Deep，同职责角色重试）
# ECHOGUIDE_RUNTIME_MAX_RETRIES=1
# 协作合成器输出预算（原硬编码 1024）
# ECHOGUIDE_RUNTIME_SYNTH_MAX_TOKENS=1024
# Runtime 层 Guard（CLI/内部调用也受注入检测与长度约束；1=启用）
# ECHOGUIDE_RUNTIME_GUARD_ENABLED=1
# Runtime 层单条消息长度上限（与 HTTP 层 GuardSettings 对齐）
# ECHOGUIDE_RUNTIME_GUARD_MAX_MESSAGE_CHARS=2000
# 出口校验 LLM 判定开关（规则校验始终开启；1=对 Deep/执行路径追加一次廉价判定调用，失败 fail-open）
# ECHOGUIDE_RUNTIME_VERIFIER_LLM=0

# ── 外部 MCP 工具源（默认关闭）───────────────────────────────────────────────
# 把远程 MCP server（如 GitHub 官方 remote server）的只读工具注册进工具管理器；
# 连接失败只记日志，服务照常启动。工具名加前缀（默认 github_），写操作工具默认跳过。
# 注册的工具默认 agent_exposed=False（LLM 不可见）；EXPOSE_AGENTS 非空时加入公共工具层（任何请求可见，仍受 Action 读写门禁）。
ECHOGUIDE_EXTERNAL_MCP_ENABLED=0
# GitHub 官方 remote MCP server（需 PAT，服务端持有，绝不写入前端）
# ECHOGUIDE_EXTERNAL_MCP_URL=https://api.githubcopilot.com/mcp/
# ECHOGUIDE_EXTERNAL_MCP_TOKEN=github_pat_xxx
# 工具名前缀（避免与本地工具冲突）
# ECHOGUIDE_EXTERNAL_MCP_PREFIX=github
# 国内网络不通时走代理
# ECHOGUIDE_EXTERNAL_MCP_PROXY=http://127.0.0.1:7897
# 只注册名单内工具（逗号分隔，支持带前缀全名或原始名；空 = 只读黑名单过滤）
# ECHOGUIDE_EXTERNAL_MCP_TOOL_WHITELIST=
# 非空 = 暴露到公共工具层（任何领域/请求可见；写操作仍受 Action 门禁）；空 = 不暴露
# ECHOGUIDE_EXTERNAL_MCP_EXPOSE_AGENTS=1

# ── 双模型 LLM-as-Judge（生成模型 ≠ 评判模型，消除自评偏差）────────────────
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_MODEL=
